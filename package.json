{
  "name": "nutria-backend",
  "version": "1.0.0",
  "description": "Backend principal de NutrIA (API REST, autenticación, gestión de pacientes y motor de validación clínica).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristianAndresHerrmann/nutria-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CristianAndresHerrmann/nutria-backend/issues"
  },
  "homepage": "https://github.com/CristianAndresHerrmann/nutria-backend#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3"
  }
}
