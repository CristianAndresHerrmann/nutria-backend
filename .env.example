# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (estos mismos valores los usa el servicio "postgres" de docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://usuario:password@postgres:5432/nutria

# Servicio de IA
IA_SERVICE_URL=http://ia:8000

# Autenticación
JWT_SECRET=
