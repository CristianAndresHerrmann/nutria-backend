# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (estos mismos valores los usa el servicio "postgres" de docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host localhost:5433 (puerto publicado por docker-compose para el servicio "postgres").
# Para ejecutar el backend dentro de Docker, docker-compose.yml sobrescribe esta variable
# con el hostname interno "postgres:5432".
DATABASE_URL=postgresql://usuario:password@localhost:5433/nutria

# Servicio de IA
# Hostname interno de Docker: por acá lo alcanza el backend. El navegador nunca
# habla con el servicio de IA directo, siempre pasa por el backend.
IA_SERVICE_URL=http://ia:8000
# Milisegundos que el backend espera al servicio de IA antes de responder 503.
IA_TIMEOUT_MS=5000

# Autenticación
JWT_SECRET=
# Intentos de login fallidos por IP antes de responder 429, y la ventana en
# milisegundos. Opcionales: por defecto, 10 cada 15 minutos.
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW_MS=

# Cuenta de administrador. Solo las lee `npm run create-admin` (en la raíz,
# `npm run db:create-admin`), que la crea o le pone al día la contraseña. La
# contraseña necesita al menos 8 caracteres. ADMIN_NAME es opcional.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Orígenes permitidos para CORS (separados por coma). Por defecto acepta el
# dominio de Docker Compose y el puerto por defecto de Vite en desarrollo local.
CORS_ORIGIN=http://local.nutria.com,http://localhost:5173

# --- Solo staging (VM de OCI; ver README, sección "Staging") ---
# En local quedan vacías: ni el compose normal ni el backend las leen.
# Dominio del frontend; el backend queda en api.<APP_HOST>. Lo usa docker-compose.staging.yml.
APP_HOST=
# Mail de contacto para los certificados de Let's Encrypt.
ACME_EMAIL=
# Contraseña de los nutricionistas del seed. Obligatoria con NODE_ENV=production.
SEED_PASSWORD=
