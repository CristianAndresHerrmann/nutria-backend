# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (estos mismos valores los usa el servicio "postgres" de docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host localhost:5433 (puerto publicado por docker-compose para el servicio "postgres").
# Para ejecutar el backend dentro de Docker, docker-compose.yml sobrescribe esta variable
# con el hostname interno "postgres:5432".
DATABASE_URL=postgresql://usuario:password@localhost:5433/nutria

# Servicio de IA
# Hostname interno de Docker: por acá lo alcanza el backend.
IA_SERVICE_URL=http://ia:8000
# Dominio público del servicio de IA: por acá lo alcanza el navegador. Se usa para
# el campo "servers" del spec de IA que sirve la documentación unificada.
IA_PUBLIC_URL=http://ia.local.nutria.com

# Autenticación
JWT_SECRET=

# Orígenes permitidos para CORS (separados por coma). Por defecto acepta el
# dominio de Docker Compose, el puerto por defecto de Vite en desarrollo local y
# la documentación interactiva, que corre en su propio dominio.
CORS_ORIGIN=http://local.nutria.com,http://localhost:5173,http://swagger.local.nutria.com
