# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (estos mismos valores los usa el servicio "postgres" de docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host localhost:5433 (puerto publicado por docker-compose para el servicio "postgres").
# Para ejecutar el backend dentro de Docker, docker-compose.yml sobrescribe esta variable
# con el hostname interno "postgres:5432".
DATABASE_URL=postgresql://usuario:password@localhost:5433/nutria

# Servicio de IA
# Hostname interno de Docker: por acá lo alcanza el backend. El navegador nunca
# habla con el servicio de IA directo, siempre pasa por el backend.
IA_SERVICE_URL=http://ia:8000
# Milisegundos que el backend espera al servicio de IA antes de responder 503.
IA_TIMEOUT_MS=5000

# Autenticación
JWT_SECRET=

# Orígenes permitidos para CORS (separados por coma). Por defecto acepta el
# dominio de Docker Compose y el puerto por defecto de Vite en desarrollo local.
CORS_ORIGIN=http://local.nutria.com,http://localhost:5173
