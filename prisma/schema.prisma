// Modelo lógico vigente — Incrementos 1 a 3.
// Incremento 1 (T4): Nutritionist y Patient con sus campos base (RF-02, RF-03, RF-15, RF-17).
// Incremento 2 (T14): datos clínicos y contextuales del paciente (RF-04 a RF-14), consultas,
// mediciones y laboratorio, hábitos pautados, y catálogos de alimentos, recetas y
// recomendaciones (RF-24, RF-25, RF-27, RF-30). T15: alimentos privados por nutricionista y
// nombres de catálogo sin distinguir mayúsculas. Incremento 3 (T31): rol, estado y fecha de
// alta de la cuenta. T32: plan alimentario, reglas clínicas, hallazgos y generaciones de IA
// (RF-34, RF-36, RF-41, RF-43, RF-47). T37: la traza de una generación fallida queda sin
// plan, colgada del paciente. Los estados de aprobación y el versionado del plan
// llegan en el Incremento 4.
//
// Convención de nombres: campos en camelCase (idiomático de Prisma/JS), mapeados con
// @map a columnas snake_case en Postgres. Los valores de los enums también son
// identificadores y van en inglés. Los datos que se cargan (seed y uso real)
// permanecen en español.
//
// Las reglas que Prisma no puede expresar (exclusiones entre columnas, detalle
// obligatorio según el tipo) son CHECK en el SQL de las migraciones
// 20261014203321_agrega_datos_clinicos_consultas_y_catalogos y
// agrega_planes_validacion_y_generaciones_ia (T32), y se validan también en los schemas
// Zod. Correspondencia con el Anexo A: docs/decisiones/ajustes-al-modelo-del-anexo-a-incremento-2.md
// y docs/decisiones/ajustes-al-modelo-del-anexo-a-incremento-3.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cuenta de acceso (T31). Un administrador es una fila más de esta tabla con
// role = admin: comparte el login, pero no tiene pacientes ni catálogo propio y
// las rutas clínicas le responden 403. Una cuenta con active = false no inicia
// sesión y su token deja de servir en la siguiente request. La baja es lógica:
// los alimentos y recomendaciones privados la referencian con RESTRICT.
model Nutritionist {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         AccountRole @default(nutritionist)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")

  patients Patient[]
  recipes  Recipe[]

  // Alimentos privados que cargó (T15): solo los ve y los usa él.
  foods Food[]

  // Recomendaciones clínicas privadas que cargó (T22): solo las ve y las edita él.
  clinicalRecommendations ClinicalRecommendation[]

  plans         Plan[]
  aiGenerations AiGeneration[]

  @@map("nutritionist")
}

enum AccountRole {
  nutritionist
  admin

  @@map("account_role")
}

model Patient {
  id             String       @id @default(uuid()) @db.Uuid
  nutritionistId String       @map("nutritionist_id") @db.Uuid
  nutritionist   Nutritionist @relation(fields: [nutritionistId], references: [id])

  // Datos personales (RF-02)
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  birthDate DateTime? @map("birth_date") @db.Date
  phone     String?
  email     String?
  livesWith String?   @map("lives_with")

  // Objetivo y referencia subjetiva (RF-03)
  goal             String?
  referenceWeight  Decimal? @map("reference_weight") @db.Decimal(5, 2)

  // Antecedentes y medicación (RF-04). Las patologías diagnosticadas no van acá:
  // son PatientCondition de tipo pathology.
  medicalHistory String? @map("medical_history")
  medication     String?

  // Tratamiento psicológico o psiquiátrico en curso (RF-05)
  externalTreatment String? @map("external_treatment")

  // Hábitos (RF-06), un campo por ítem
  physicalActivity String? @map("physical_activity")
  smoking          String?
  alcohol          String?
  mealSchedule     String? @map("meal_schedule")
  sleepSchedule    String? @map("sleep_schedule")

  // Contexto de cocina (RF-08)
  cooks              Boolean?
  likesCooking       Boolean? @map("likes_cooking")
  cookingTime        String?  @map("cooking_time")
  homeEquipment      String?  @map("home_equipment")
  usualShoppingPlace String?  @map("usual_shopping_place")

  // Comidas fuera del hogar (RF-09)
  mealsOutsideHome String? @map("meals_outside_home")
  outsideEquipment String? @map("outside_equipment")

  // Ocupación y contexto laboral (RF-10)
  occupation  String?
  workContext String? @map("work_context")

  // Patrones de ingesta fuera de las comidas planificadas (RF-14)
  intakePatterns String? @map("intake_patterns")

  // Adulto responsable, obligatorio en la aplicación cuando el paciente es menor (RF-17)
  guardianName         String?  @map("guardian_name")
  guardianRelationship String?  @map("guardian_relationship")
  guardianContact      String?  @map("guardian_contact")
  attendsAccompanied   Boolean? @map("attends_accompanied")

  // Registro incompleto y su corrección (RF-15, RNF-03)
  registrationComplete Boolean   @default(false) @map("registration_complete")
  dataCompletedAt      DateTime? @map("data_completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conditions    PatientCondition[]
  consultations Consultation[]
  measurements  Measurement[]
  plans         Plan[]
  aiGenerations AiGeneration[]

  // Destino de las FK compuestas de Plan (T32) y AiGeneration (T37): el plan y
  // la generación llevan el mismo nutricionista que su paciente.
  @@unique([id, nutritionistId])
  @@map("patient")
}

// ---------------------------------------------------------------------------
// Pacientes y consultas (Anexo A.1)
// ---------------------------------------------------------------------------

// Catálogo común a todos los nutricionistas. name es citext: el @unique no
// distingue mayúsculas (ver "Catálogos" más abajo).
model Pathology {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.Citext
  description String?

  conditions      PatientCondition[]
  recommendations ClinicalRecommendation[]
  clinicalRules   ClinicalRule[]

  @@map("pathology")
}

enum ConditionType {
  pathology
  allergy
  intolerance
  rejection
  preference

  @@map("condition_type")
}

// Condición del paciente (RF-04, RF-07). CHECK en la migración: pathologyId existe
// si y solo si type = pathology; una condición pathology no referencia alimentos y
// las demás referencian exactamente uno de foodId / foodGroupId.
model PatientCondition {
  id           String        @id @default(uuid()) @db.Uuid
  patientId    String        @map("patient_id") @db.Uuid
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type         ConditionType
  pathologyId  String?       @map("pathology_id") @db.Uuid
  pathology    Pathology?    @relation(fields: [pathologyId], references: [id], onDelete: Restrict)
  foodId       String?       @map("food_id") @db.Uuid
  food         Food?         @relation(fields: [foodId], references: [id], onDelete: Restrict)
  foodGroupId  String?       @map("food_group_id") @db.Uuid
  foodGroup    FoodGroup?    @relation(fields: [foodGroupId], references: [id], onDelete: Restrict)
  registeredAt DateTime      @default(now()) @map("registered_at") @db.Date
  observations String?

  findings Finding[]

  @@index([patientId])
  @@map("patient_condition")
}

enum ConsultationType {
  first
  follow_up

  @@map("consultation_type")
}

// Consulta (RF-13, RF-18). Se aísla por nutricionista a través del paciente.
model Consultation {
  id                String           @id @default(uuid()) @db.Uuid
  patientId         String           @map("patient_id") @db.Uuid
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date              DateTime         @db.Date
  type              ConsultationType
  motivation        String?
  decisionOrigin    String?          @map("decision_origin")
  perceivedObstacle String?          @map("perceived_obstacle")
  mainHabit         String?          @map("main_habit")
  observations      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  measurements     Measurement[]
  habitsSet        PrescribedHabit[] @relation("HabitSetIn")
  habitsEvaluated  PrescribedHabit[] @relation("HabitEvaluatedIn")

  @@index([patientId, date])
  @@map("consultation")
}

enum MeasurementType {
  weight
  height
  skinfold
  circumference
  cholesterol
  triglycerides
  glucose
  other

  @@map("measurement_type")
}

// Medición antropométrica o de laboratorio (RF-11, RF-12). Puede cargarse fuera de
// una consulta. El IMC no se guarda: se calcula a partir de peso y talla. CHECK en la
// migración: detail obligatorio para skinfold, circumference y other; value > 0.
model Measurement {
  id             String          @id @default(uuid()) @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?         @map("consultation_id") @db.Uuid
  consultation   Consultation?   @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  type           MeasurementType
  detail         String?
  value          Decimal         @db.Decimal(8, 2)
  unit           String?
  date           DateTime        @db.Date

  @@index([patientId, type, date])
  @@map("measurement")
}

enum HabitCompliance {
  pending
  met
  partial
  not_met

  @@map("habit_compliance")
}

// Hábito pautado al cierre de una consulta y evaluado en una posterior (RF-21).
// CHECK en la migración: la consulta que evalúa no es la que establece.
model PrescribedHabit {
  id                       String          @id @default(uuid()) @db.Uuid
  consultationId           String          @map("consultation_id") @db.Uuid
  consultation             Consultation    @relation("HabitSetIn", fields: [consultationId], references: [id], onDelete: Cascade)
  evaluationConsultationId String?         @map("evaluation_consultation_id") @db.Uuid
  evaluationConsultation   Consultation?   @relation("HabitEvaluatedIn", fields: [evaluationConsultationId], references: [id], onDelete: SetNull)
  description              String
  compliance               HabitCompliance @default(pending)
  evaluationObservations   String?         @map("evaluation_observations")

  @@index([consultationId])
  @@index([evaluationConsultationId])
  @@map("prescribed_habit")
}

// ---------------------------------------------------------------------------
// Catálogos (Anexo A.2). Comunes a todos los nutricionistas, salvo Recipe.
// ---------------------------------------------------------------------------

// T15: los nombres de FoodGroup, Food y Pathology son citext, así que la unicidad
// no distingue mayúsculas ("Leche" y "leche" chocan). La extensión se crea a mano
// en la migración de T15. Grupos y patologías son siempre comunes; un alimento puede
// ser común o privado de un nutricionista (ver Food). Los nutricionistas no editan
// el catálogo: lo cura un administrador (tarea aparte) o el seed. Ver
// docs/decisiones/abm-de-catalogos-comunes.md y
// docs/decisiones/nombres-de-catalogo-sin-distinguir-mayusculas.md en el repo raíz.

// Grupo de alimentos jerárquico (RF-24). CHECK en la migración: no es su propio padre.
// Los ciclos más largos los impide el servicio (no se pueden expresar como CHECK).
model FoodGroup {
  id          String      @id @default(uuid()) @db.Uuid
  parentId    String?     @map("parent_id") @db.Uuid
  parent      FoodGroup?  @relation("FoodGroupHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    FoodGroup[] @relation("FoodGroupHierarchy")
  name        String      @unique @db.Citext
  description String?

  foods         Food[]
  conditions    PatientCondition[]
  clinicalRules ClinicalRule[]
  optionItems   OptionItem[]

  @@index([parentId])
  @@map("food_group")
}

// Alimento (RF-24). Se desactiva con active = false en vez de borrarse, porque lo
// referencian condiciones e ingredientes: la API no tiene DELETE y las FK con
// onDelete: Restrict impiden el borrado físico de uno en uso.
//
// nutritionistId null = común (seed o administrador); con valor = privado: solo ese
// nutricionista lo ve y lo usa (T15). El nombre es único dentro de lo que ve cada
// nutricionista: el @@unique cubre los privados de un mismo nutricionista, y el
// servicio chequea el cruce con los comunes y la unicidad entre comunes (Postgres
// trata los null como distintos en un índice único).
model Food {
  id             String        @id @default(uuid()) @db.Uuid
  foodGroupId    String        @map("food_group_id") @db.Uuid
  foodGroup      FoodGroup     @relation(fields: [foodGroupId], references: [id], onDelete: Restrict)
  name           String        @db.Citext
  active         Boolean       @default(true)
  nutritionistId String?       @map("nutritionist_id") @db.Uuid
  nutritionist   Nutritionist? @relation(fields: [nutritionistId], references: [id], onDelete: Restrict)

  categories    FoodCategory[]
  conditions    PatientCondition[]
  ingredients   RecipeIngredient[]
  clinicalRules ClinicalRule[]
  optionItems   OptionItem[]

  @@unique([nutritionistId, name])
  @@index([foodGroupId])
  @@map("food")
}

enum FoodCategoryType {
  protein
  carbohydrate
  fiber
  vegetable
  healthy_fat
  infusion
  // Alimentos sin aporte a la composición esperada: azúcar, sal, condimentos,
  // grasas sólidas, agua (DA-32). Nunca es una categoría que una comida exija.
  complementary

  @@map("food_category_type")
}

// Categorías nutricionales de un alimento, una o más (RF-25).
model FoodCategory {
  id       String           @id @default(uuid()) @db.Uuid
  foodId   String           @map("food_id") @db.Uuid
  food     Food             @relation(fields: [foodId], references: [id], onDelete: Cascade)
  category FoodCategoryType

  @@unique([foodId, category])
  @@map("food_category")
}

enum CookingMethod {
  oven
  stovetop
  microwave
  no_cooking

  @@map("cooking_method")
}

enum RecipeOrigin {
  professional
  ai_generated

  @@map("recipe_origin")
}

// Receta (RF-27). Pertenece a un nutricionista (RNF-05). CHECK en la migración:
// timeMinutes > 0. originPlanId (plan_origen_id del Anexo A, T32) es el plan para el
// que se generó; el servicio controla que sea del mismo nutricionista.
model Recipe {
  id                 String         @id @default(uuid()) @db.Uuid
  nutritionistId     String         @map("nutritionist_id") @db.Uuid
  nutritionist       Nutritionist   @relation(fields: [nutritionistId], references: [id])
  originPlanId       String?        @map("origin_plan_id") @db.Uuid
  originPlan         Plan?          @relation(fields: [originPlanId], references: [id], onDelete: SetNull)
  name               String
  preparation        String?
  finalNote          String?        @map("final_note")
  cookingMethod      CookingMethod? @map("cooking_method")
  timeMinutes        Int?           @map("time_minutes")
  purchasePlace      String?        @map("purchase_place")
  origin             RecipeOrigin   @default(professional)
  availableInCatalog Boolean        @default(true) @map("available_in_catalog")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ingredients RecipeIngredient[]
  mealTypes   RecipeMealType[]
  optionItems OptionItem[]

  @@index([nutritionistId])
  @@index([originPlanId])
  @@map("recipe")
}

model RecipeIngredient {
  id                  String  @id @default(uuid()) @db.Uuid
  recipeId            String  @map("recipe_id") @db.Uuid
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId              String  @map("food_id") @db.Uuid
  food                Food    @relation(fields: [foodId], references: [id], onDelete: Restrict)
  quantityDescription String? @map("quantity_description")
  order               Int

  @@unique([recipeId, order])
  @@index([foodId])
  @@map("recipe_ingredient")
}

enum MealType {
  breakfast
  lunch
  afternoon_snack
  dinner

  @@map("meal_type")
}

model RecipeMealType {
  id       String   @id @default(uuid()) @db.Uuid
  recipeId String   @map("recipe_id") @db.Uuid
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mealType MealType @map("meal_type")

  @@unique([recipeId, mealType])
  @@map("recipe_meal_type")
}

// Recomendación clínica estándar por patología (RF-30), reutilizable entre
// pacientes. Como los alimentos (T15): nutritionistId null es común (la carga el
// seed y nadie la edita desde la API); con valor es privada de ese
// nutricionista, que la crea, la edita y la da de baja (T22). Las
// recomendaciones de hábitos de cada paciente no van acá (RF-31): son los
// hábitos pautados.
model ClinicalRecommendation {
  id             String        @id @default(uuid()) @db.Uuid
  pathologyId    String        @map("pathology_id") @db.Uuid
  pathology      Pathology     @relation(fields: [pathologyId], references: [id], onDelete: Restrict)
  nutritionistId String?       @map("nutritionist_id") @db.Uuid
  nutritionist   Nutritionist? @relation(fields: [nutritionistId], references: [id], onDelete: Restrict)
  title          String
  text           String
  active         Boolean       @default(true)

  @@index([pathologyId])
  @@index([nutritionistId])
  @@map("clinical_recommendation")
}

// ---------------------------------------------------------------------------
// Planes, validación y trazabilidad (Anexo A.3, T32). Ver
// docs/decisiones/ajustes-al-modelo-del-anexo-a-incremento-3.md en el repo raíz.
// ---------------------------------------------------------------------------

// Solo borrador por ahora: aprobado (RF-48) se agrega en el Incremento 4 con un
// ALTER TYPE ... ADD VALUE.
enum PlanStatus {
  draft

  @@map("plan_status")
}

// Plan alimentario de un paciente (RF-34): por tipo de comida, con opciones
// intercambiables, sin estructura por días. Lleva nutritionistId además del
// paciente para que el aislamiento (RNF-05) filtre en la misma tabla. La FK
// compuesta (patient_id, nutritionist_id) → patient(id, nutritionist_id) hace que
// la base rechace un plan con un nutricionista distinto al de su paciente.
//
// Las recomendaciones son cuatro textos editables (RF-40). Las que se toman del
// catálogo se copian en clinicalRecommendations: un plan no cambia por una
// corrección posterior del catálogo (DA-16).
model Plan {
  id             String       @id @default(uuid()) @db.Uuid
  patientId      String       @map("patient_id") @db.Uuid
  patient        Patient      @relation(fields: [patientId, nutritionistId], references: [id, nutritionistId], onDelete: Cascade)
  nutritionistId String       @map("nutritionist_id") @db.Uuid
  nutritionist   Nutritionist @relation(fields: [nutritionistId], references: [id])
  status         PlanStatus   @default(draft)

  situationalDiagnosis String? @map("situational_diagnosis")
  introduction         String?
  objectives           String?

  generalRecommendations    String? @map("general_recommendations")
  contextualRecommendations String? @map("contextual_recommendations")
  clinicalRecommendations   String? @map("clinical_recommendations")
  thematicRecommendations   String? @map("thematic_recommendations")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meals         PlanMeal[]
  findings      Finding[]
  aiGenerations AiGeneration[]
  recipes       Recipe[]

  @@index([patientId])
  @@index([nutritionistId])
  @@map("plan")
}

// Una comida del plan por tipo. El fraccionamiento es una indicación en texto
// para el paciente, no una estructura aparte (RF-36).
model PlanMeal {
  id           String   @id @default(uuid()) @db.Uuid
  planId       String   @map("plan_id") @db.Uuid
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  mealType     MealType @map("meal_type")
  instructions String?

  options MealOption[]

  @@unique([planId, mealType])
  @@map("plan_meal")
}

// Opción intercambiable dentro de una comida.
model MealOption {
  id          String   @id @default(uuid()) @db.Uuid
  planMealId  String   @map("plan_meal_id") @db.Uuid
  planMeal    PlanMeal @relation(fields: [planMealId], references: [id], onDelete: Cascade)
  order       Int
  description String?

  items    OptionItem[]
  findings Finding[]

  @@unique([planMealId, order])
  @@map("meal_option")
}

enum OptionItemType {
  food
  food_group
  recipe
  unrecognized

  @@map("option_item_type")
}

// Ítem de una opción. Cada tipo referencia exactamente lo suyo (CHECK
// option_item_type_chk en la migración, y optionItemSchema en la aplicación):
//   food:         foodId + copia de foodName y foodCategories (DA-16)
//   food_group:   foodGroupId + copia de foodGroupName ("una fruta", DA-16)
//   recipe:       recipeId
//   unrecognized: originalText, el texto de la propuesta que no se resolvió contra
//                 el catálogo (DA-26)
// Las copias las arma el backend desde el catálogo, nunca el cliente. Que el
// alimento sea visible para el nutricionista y la receta sea suya lo controla el
// servicio.
model OptionItem {
  id             String             @id @default(uuid()) @db.Uuid
  optionId       String             @map("option_id") @db.Uuid
  option         MealOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  order          Int
  type           OptionItemType
  foodId         String?            @map("food_id") @db.Uuid
  food           Food?              @relation(fields: [foodId], references: [id], onDelete: Restrict)
  foodName       String?            @map("food_name")
  foodCategories FoodCategoryType[] @default([]) @map("food_categories")
  foodGroupId    String?            @map("food_group_id") @db.Uuid
  foodGroup      FoodGroup?         @relation(fields: [foodGroupId], references: [id], onDelete: Restrict)
  foodGroupName  String?            @map("food_group_name")
  recipeId       String?            @map("recipe_id") @db.Uuid
  recipe         Recipe?            @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  originalText   String?            @map("original_text")

  findings Finding[]

  @@unique([optionId, order])
  @@index([foodId])
  @@index([foodGroupId])
  @@index([recipeId])
  @@map("option_item")
}

enum RuleSeverity {
  prohibited
  moderate

  @@map("rule_severity")
}

// Regla clínica por patología (RF-47): restringe un alimento o un grupo, con su
// fuente bibliográfica. Catálogo común, como las patologías (DA-15); se da de baja
// con active = false porque los hallazgos la referencian. Las reglas se cargan en
// T35. CHECK en la migración: exactamente uno de foodId / foodGroupId; source no
// vacía.
model ClinicalRule {
  id          String       @id @default(uuid()) @db.Uuid
  pathologyId String       @map("pathology_id") @db.Uuid
  pathology   Pathology    @relation(fields: [pathologyId], references: [id], onDelete: Restrict)
  foodId      String?      @map("food_id") @db.Uuid
  food        Food?        @relation(fields: [foodId], references: [id], onDelete: Restrict)
  foodGroupId String?      @map("food_group_id") @db.Uuid
  foodGroup   FoodGroup?   @relation(fields: [foodGroupId], references: [id], onDelete: Restrict)
  severity    RuleSeverity
  source      String
  active      Boolean      @default(true)

  findings Finding[]

  @@index([pathologyId])
  @@index([foodId])
  @@index([foodGroupId])
  @@map("clinical_rule")
}

enum FindingType {
  direct_condition
  pathology_rule
  composition
  unrecognized_item

  @@map("finding_type")
}

enum FindingSeverity {
  blocking
  warning

  @@map("finding_severity")
}

// Hallazgo de la validación determinística de un plan (RF-43, RF-44). Se
// recalculan en cada revalidación (RF-46). CHECK finding_origin_chk en la
// migración:
//   direct_condition:  optionItemId + patientConditionId
//   pathology_rule:    optionItemId + clinicalRuleId
//   composition:       optionId, sin ítem
//   unrecognized_item: optionItemId
// La severidad la decide el motor de reglas, no la base. Que el ítem o la opción
// sean del mismo plan lo controla el servicio.
model Finding {
  id                 String            @id @default(uuid()) @db.Uuid
  planId             String            @map("plan_id") @db.Uuid
  plan               Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  optionId           String?           @map("option_id") @db.Uuid
  option             MealOption?       @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionItemId       String?           @map("option_item_id") @db.Uuid
  optionItem         OptionItem?       @relation(fields: [optionItemId], references: [id], onDelete: Cascade)
  type               FindingType
  severity           FindingSeverity
  clinicalRuleId     String?           @map("clinical_rule_id") @db.Uuid
  clinicalRule       ClinicalRule?     @relation(fields: [clinicalRuleId], references: [id], onDelete: Restrict)
  patientConditionId String?           @map("patient_condition_id") @db.Uuid
  patientCondition   PatientCondition? @relation(fields: [patientConditionId], references: [id], onDelete: Cascade)
  message            String
  detectedAt         DateTime          @default(now()) @map("detected_at")

  @@index([planId])
  @@index([optionId])
  @@index([optionItemId])
  @@index([clinicalRuleId])
  @@index([patientConditionId])
  @@map("finding")
}

// Cómo terminó la llamada al proveedor. Los errores son los que el IA2 prevé como
// recuperables: tiempo agotado, falla del proveedor y respuesta fuera del esquema.
enum AiGenerationResult {
  success
  invalid_response
  provider_error
  timeout

  @@map("ai_generation_result")
}

// Resultado de validar la propuesta tal como llegó (RF-41). Se guarda aparte de
// los hallazgos del plan, que se recalculan con cada edición.
enum AiValidationResult {
  no_findings
  warnings
  blocking

  @@map("ai_validation_result")
}

// Una fila por generación asistida de un plan (RF-41, RNF-11). contextSent es el
// contexto anonimizado que efectivamente se envió: sin datos identificatorios del
// paciente (lo arma el backend, ver el skill servicio-ia-fastapi).
//
// T37 (DA-31, modifica DA-27): el borrador se crea solo cuando la generación
// salió bien, en la misma transacción que su traza. Una generación fallida queda
// registrada sin plan, aislada por su paciente: la FK compuesta (patient_id,
// nutritionist_id) → patient(id, nutritionist_id) es la misma que la de Plan.
// CHECK en la migración: duración y tokens no negativos; rawResponse presente
// cuando el proveedor respondió (success, invalid_response); validationResult
// solo cuando result = success; planId presente si y solo si result = success
// (ai_generation_plan_chk). Que el plan sea de ese paciente lo controla el
// servicio.
model AiGeneration {
  id               String              @id @default(uuid()) @db.Uuid
  planId           String?             @map("plan_id") @db.Uuid
  plan             Plan?               @relation(fields: [planId], references: [id], onDelete: Cascade)
  patientId        String              @map("patient_id") @db.Uuid
  patient          Patient             @relation(fields: [patientId, nutritionistId], references: [id, nutritionistId], onDelete: Cascade)
  nutritionistId   String              @map("nutritionist_id") @db.Uuid
  nutritionist     Nutritionist        @relation(fields: [nutritionistId], references: [id])
  contextSent      Json                @map("context_sent")
  provider         String
  model            String
  templateVersion  String              @map("template_version")
  rawResponse      String?             @map("raw_response")
  durationMs       Int                 @map("duration_ms")
  inputTokens      Int?                @map("input_tokens")
  outputTokens     Int?                @map("output_tokens")
  result           AiGenerationResult
  validationResult AiValidationResult? @map("validation_result")
  generatedAt      DateTime            @default(now()) @map("generated_at")

  @@index([planId])
  @@index([patientId])
  @@index([nutritionistId])
  @@map("ai_generation")
}
